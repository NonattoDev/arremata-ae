{
  "name": "arremata-ae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4168",
    "build": "next build",
    "start": "next start --port 4168",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:setup": "tsx --env-file=.env.local scripts/setup.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "db:seed": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "credit-card-type": "^10.3.1",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
