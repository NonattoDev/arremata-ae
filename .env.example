# Set DATABASE_URL for hosted PostgreSQL. Local development can use PGlite.
DATABASE_URL=
LOCAL_DATABASE_PATH=.local/postgres
AUDIT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-different-random-secret
APP_URL=http://localhost:4168
DEMO_PASSWORD=choose-a-demo-password-at-least-12-characters
